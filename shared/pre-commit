#!/bin/sh
# 分支守卫的 git 层入口。Claude Code 的 PreToolUse hook 拦 agent 经 Bash 发的命令，
# 这个拦本机的 git commit —— **只有 commit**：merge 走 pre-merge-commit、
# rebase/cherry-pick/revert/am 走分离头指针、push 完全不经过这里，都管不到。
# 逻辑在 scripts/guard-branch.js 里，两边共用一份。
#
# **这份文件是从 GinkgoLeafLab/dev-infra 同步进来的，不要手改。**
# 改它去那边走 PR、打 tag，再回来 node scripts/vendor-infra.js --sync <tag>。
# 下面那行相对路径写死了它的落点：这个文件必须躺在 .githooks/pre-commit，
# 而 guard-branch.js 躺在 scripts/ —— 换落点就要连这一行一起改。
#
# 它还必须有可执行位，否则 git 直接跳过、**不报任何错**。
# scripts/setup-hooks.js 在 npm install 时会补上。
exec node "$(dirname "$0")/../scripts/guard-branch.js" --pre-commit
